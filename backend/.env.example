# ==========================================
# Backend Environment Configuration Template
# ==========================================

# Application
APP_NAME="Danang Urban Incident Management Platform"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=urban_incidents
# Set this directly in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres123@db:5432/urban_incidents

# AI & Multimodal Triage (DeepSeek API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash

# Maps & Geocoding (Goong Maps)
GOONG_API_KEY=your_goong_api_key_here
GOONG_MAPTILES_KEY=your_goong_maptiles_key_here

# Social Media Channels - Facebook Messenger
FACEBOOK_PAGE_ACCESS_TOKEN=your_fb_page_access_token_here
FACEBOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
